# Copy to `.env` and fill in. install.sh generates this automatically.
SUZU_TOKEN=change-me-please
SUZU_HOST=0.0.0.0
SUZU_PORT=8765

# Optional — pin a default model / iteration limit (the client can override per request)
SUZU_DEFAULT_MODEL=claude-3-5-sonnet-20241022
SUZU_DEFAULT_MAX_ITERATIONS=100

# Tool paths — install.sh sets these to /opt/suzu-tools/...
# SUZU_APKTOOL_JAR=/opt/suzu-tools/apktool.jar
# SUZU_JADX_BIN=/opt/suzu-tools/jadx/bin/jadx
# SUZU_APKSIGNER_BIN=/opt/suzu-tools/android-sdk/build-tools/34.0.0/apksigner
# SUZU_ZIPALIGN_BIN=/opt/suzu-tools/android-sdk/build-tools/34.0.0/zipalign
